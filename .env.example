# Public site URL
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/deldora_travel_uz

# Required admin account used by the server-side login API
ADMIN_EMAIL=admin@deldora.travel
ADMIN_PASSWORD=change-this-password

# At least 32 random characters
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Payload CMS secret: at least 32 random characters
PAYLOAD_SECRET=replace-with-another-long-random-secret

# Leave empty for local payload.db. For Turso, use libsql://... and an auth token.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
